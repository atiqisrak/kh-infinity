{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/products",
            "destination": "/products.html"
        }
    ],
    "rewrites": [
        {
            "source": "/((?!components|images|css|js|blog|products|zohoverify).*?)(?:\\?.*)?$",
            "destination": "/$1.html"
        }
    ]
}